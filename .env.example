##############################################################################
# DAWANA — ENVIRONMENT VARIABLES
# Copy to `.env.local` for development. Add the same keys in Vercel under
# Project → Settings → Environment Variables (Production + Preview).
##############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# Dashboard → Project Settings → API Keys  (and Data API for the URL)
# ─────────────────────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key: "anon public" (legacy tab) or "publishable" (sb_publishable_…).
# Safe to expose — the database only lets it read published catalogue rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server key: "service_role" (legacy tab) or "secret" (sb_secret_…).
# SERVER ONLY — bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# ADMIN SIGN-IN
# ─────────────────────────────────────────────────────────────────────────────

# Signs the control-room session cookie. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, used for metadata, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=https://www.dawa-na.com


# ─────────────────────────────────────────────────────────────────────────────
# VERCEL  (injected automatically — do not set these yourself)
# Read by /api/health to report the running environment.
#   VERCEL_ENV              production | preview | development
#   VERCEL_REGION           e.g. fra1
#   VERCEL_GIT_COMMIT_SHA   commit hash, shown in Site Health
# ─────────────────────────────────────────────────────────────────────────────
