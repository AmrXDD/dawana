##############################################################################
# DAWANA — ENVIRONMENT VARIABLES
# Copy to `.env.local` for development. Add the same keys in Vercel under
# Project → Settings → Environment Variables.
##############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE  (required for the catalogue, admin auth and document storage)
# Dashboard → Project Settings → Data API  /  API Keys
# ─────────────────────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — bypasses RLS entirely.
# Never prefix with NEXT_PUBLIC_. In Vercel, do NOT expose it to Preview
# deployments unless you need it there.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# RESEND  (required for contact-form email + sending generated documents)
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Must be on a domain you've verified in Resend, e.g. noreply@dawa-na.com
RESEND_FROM_EMAIL=noreply@dawa-na.com

# Where website enquiries are delivered. Defaults to dawana@dawa-na.com.
CONTACT_INBOX_EMAIL=dawana@dawa-na.com


# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, used for metadata, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=https://www.dawa-na.com


# ─────────────────────────────────────────────────────────────────────────────
# VERCEL  (injected automatically — do not set these yourself)
# Read by /api/health to report the running environment.
#   VERCEL_ENV              production | preview | development
#   VERCEL_REGION           e.g. fra1
#   VERCEL_GIT_COMMIT_SHA   commit hash, shown in Site Health
# ─────────────────────────────────────────────────────────────────────────────
